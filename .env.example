# Copy this file to .env (never commit .env) and fill it in.
STEAM_API_KEY=
STEAM_ID=

# The owner password. Only someone who knows it can edit the tracker. Make it long and random (20+ characters).
ADMIN_TOKEN=

PORT=3000

# Which time zone counts as "today" for playtime history, for example Asia/Manila
TIMEZONE=UTC

# Set to 1 when the site runs behind a reverse proxy or a host like Render or Railway.
# Without it, every visitor looks like the same address to the rate limiter.
# TRUST_PROXY=1

# Where tracker.json and history.json are saved. Point this at a persistent disk on your host.
# DATA_DIR=/var/data

# Personal notes are hidden from visitors by default. Set to true to show them to everyone.
# PUBLIC_NOTES=false

# Turns off the Content-Security-Policy header if it ever blocks something you need.
# DISABLE_CSP=1
